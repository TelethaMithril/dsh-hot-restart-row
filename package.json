{
  "name": "dsh-hot-restart-row",
  "version": "0.2.8",
  "description": "Adds a Hot restart row under Sign out in the DSH account menu: reconciles the profile plugin tree in place and reloads the page, without restarting the DSH process or dropping the current conversation.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime/menu.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "TelethaMithril",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TelethaMithril/dsh-hot-restart-row.git"
  },
  "homepage": "https://github.com/TelethaMithril/dsh-hot-restart-row#readme",
  "bugs": {
    "url": "https://github.com/TelethaMithril/dsh-hot-restart-row/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "hot-restart",
    "reload"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
